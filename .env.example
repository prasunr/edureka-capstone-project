# Copy this file to .env and paste your Gemini API key.
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-api-key-here

# Optional: override the Gemini model used for translation.
# Default is gemini-flash-latest (alias that always points to the
# current flash model). Run `client.models.list()` to see options.
# GEMINI_MODEL=gemini-flash-latest
